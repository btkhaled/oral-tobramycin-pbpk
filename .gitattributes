# Git LFS for large binaries (TOUT upload, but LFS for efficiency)
# PDFs (manuscript, slides)
*.pdf filter=lfs diff=lfs merge=lfs -text
# PK-Sim model binaries
*.pkml filter=lfs diff=lfs merge=lfs -text
*.pksim5 filter=lfs diff=lfs merge=lfs -text
# Images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
# Data (large CSVs)
*.csv filter=lfs diff=lfs merge=lfs -text
# R data
*.rds filter=lfs diff=lfs merge=lfs -text
*.rda filter=lfs diff=lfs merge=lfs -text
# Slides
*.pptx filter=lfs diff=lfs merge=lfs -text
# Archives
*.zip filter=lfs diff=lfs merge=lfs -text

# Keep symlinks as symlinks (not LFS)
# (Git stores symlinks as symlinks by default)
